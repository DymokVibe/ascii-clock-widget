<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text=":: ASCII CLOCK ::"
        android:textColor="@color/ascii_clock_secondary"
        android:textSize="14sp"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/preview_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingMultiplier="0.90"
        android:textColor="@color/ascii_clock_primary"
        android:textSize="13sp"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/preview_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="28dp"
        android:textColor="@color/ascii_clock_secondary"
        android:textSize="12sp"
        android:typeface="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_style_shaded"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="#1A1A1A"
            android:text="Shaded (@#%+)"
            android:textAllCaps="false"
            android:textColor="@color/ascii_clock_primary"
            android:typeface="monospace" />

        <Button
            android:id="@+id/btn_style_minimal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="#1A1A1A"
            android:text="Minimal (#:)"
            android:textAllCaps="false"
            android:textColor="@color/ascii_clock_primary"
            android:typeface="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/sync_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/ascii_clock_secondary"
        android:textSize="12sp"
        android:typeface="monospace" />

    <Button
        android:id="@+id/btn_exact_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#222222"
        android:text="Разрешить точное обновление"
        android:textAllCaps="false"
        android:textColor="@color/ascii_clock_primary"
        android:typeface="monospace"
        android:visibility="gone" />

</LinearLayout>
